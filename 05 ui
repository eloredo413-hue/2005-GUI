local function break2005FigureJointsOnKill(hitModel)
	if not hitModel then return end
	local targetRig = (S.rigRegistry and S.rigRegistry[hitModel])
		or hitModel:FindFirstChild("Dynablox2005Rig")
		or (hitModel:GetAttribute("IsDynabloxFigure") and hitModel)
		or nil
	if targetRig then
		for _, desc in ipairs(targetRig:GetDescendants()) do
			if desc:IsA("WeldConstraint") or desc:IsA("Motor6D") then
				if desc.Name ~= "BumpWeld" and desc.Name ~= "RootWeld2005" then
					desc.Enabled = false
				end
			elseif desc:IsA("BasePart") and not desc:GetAttribute("Is2005Bump") then
				desc.Anchored = false
				desc.CanCollide = true
				desc.AssemblyLinearVelocity = Vector3.new(
					(math.random() - 0.5) * 18,
					math.random(10, 22),
					(math.random() - 0.5) * 18
				)
			end
		end
	end
end

local function hookInteractive2005Model(part, rewardScore, rewardTime, isWin, isLose)
	storeConnection(part.Touched:Connect(function(hit)
		if not S.isSimulationRunning then return end
		if not hit or not hit.Parent or hit == part or hit:IsDescendantOf(part) then return end
		if hit:GetAttribute("Is2005Bump") then return end
		local hitModel = hit:FindFirstAncestorOfClass("Model")
		if hitModel == LocalPlayer.Character or (hit.Parent and hit.Parent:IsDescendantOf(SpawnedModelsFolder)) then
			if part:GetAttribute("TriggeredInRun") then return end
			part:SetAttribute("TriggeredInRun", true)
			if rewardScore and rewardScore ~= 0 then
				S.bonusScore = S.bonusScore + rewardScore
				playClassicSound(SOUND_BOOP, 0.6, 1.3)
			end
			if rewardTime and rewardTime ~= 0 then
				S.currentTimerValue = S.currentTimerValue + rewardTime
				playClassicSound(SOUND_BOOP, 0.6, 1.5)
			end
			if isWin then
				S.bonusScore = S.bonusScore + 1000
				playClassicSound(SOUND_WIN, 0.7, 1)
				showCenterBanner("You Won! Score: " .. tostring(getTotalScore()))
			elseif isLose then
				playClassicSound(SOUND_BOOP, 0.7, 0.6)
				break2005FigureJointsOnKill(hitModel)
				showCenterBanner("You Lost. Try Again")
			end
			updateScoreTimerUI()
			task.delay(1.5, function()
				if part then part:SetAttribute("TriggeredInRun", nil) end
			end)
		end
	end))
end

