			rowFrame.LayoutOrder = i
			rowFrame.Size = UDim2.new(1, 0, 0, 20)
			rowFrame.BackgroundColor3 = (i % 2 == 0) and Color3.fromRGB(246, 245, 240) or Color3.fromRGB(255, 255, 255)
